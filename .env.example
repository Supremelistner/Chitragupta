# =============================================================================
# Chitragupta — Central Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real tokens.

# -------------------------------------------------------------------------------
# HuggingFace Inference API
# -------------------------------------------------------------------------------
# Get token at: https://huggingface.co/settings/tokens
# Permission required: "Make calls to Inference Providers"
HF_TOKEN=

# -------------------------------------------------------------------------------
# Model Service
# -------------------------------------------------------------------------------
MODEL_SERVICE_PROVIDER=huggingface
MODEL_SERVICE_HF_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
MODEL_SERVICE_HTTP_HOST=127.0.0.1
MODEL_SERVICE_HTTP_PORT=8081
MODEL_SERVICE_LOG_LEVEL=INFO

# Inference defaults
MODEL_SERVICE_TEMPERATURE=0.1
MODEL_SERVICE_MAX_TOKENS=2048
MODEL_SERVICE_TIMEOUT_SECONDS=30
MODEL_SERVICE_MAX_IMAGE_BYTES=10485760

# -------------------------------------------------------------------------------
# Google Gemini (Google AI Studio)
# -------------------------------------------------------------------------------
# Get a key at: https://aistudio.google.com/apikey
# Free tier (Sept 2026):
#   gemini-2.5-flash-lite: 250K TPM, 15 RPM, 1K RPD (best free default)
#   gemini-2.5-flash-preview-tts: 1M chars/day, supports Hindi/Tamil/Telugu/
#     Bengali/Marathi/Gujarati/Kannada/Malayalam/Punjabi and 24+ other
#     languages. Used by the elderly-friendly UI voice output.
#
# When GEMINI_API_KEY is set, the model service uses Gemini for vision +
# classification + extraction, and the orchestrator uses Gemini as its
# primary chat LLM (with optional Groq fallback). To fall back to the
# HuggingFace/Qwen path, leave GEMINI_API_KEY blank and set
# MODEL_SERVICE_PROVIDER=huggingface.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_LLM_MODEL=gemini-2.5-flash-lite
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# -------------------------------------------------------------------------------
# Orchestrator Service
# -------------------------------------------------------------------------------
ORCHESTRATOR_APP_NAME=orchestrator-service
ORCHESTRATOR_ENV=development
ORCHESTRATOR_LOG_LEVEL=INFO
ORCHESTRATOR_HTTP_HOST=127.0.0.1
ORCHESTRATOR_HTTP_PORT=8084
ORCHESTRATOR_MODEL=Qwen/Qwen3-8B
ORCHESTRATOR_TEMPERATURE=0.1
ORCHESTRATOR_MAX_TOKENS=4096
ORCHESTRATOR_LLM_TIMEOUT=60
ORCHESTRATOR_SESSION_DIR=./data/sessions
ORCHESTRATOR_CONFIRM_THRESHOLD=3
DOCUMENT_SERVICE_URL=http://localhost:8080
MODEL_SERVICE_URL=http://localhost:8081
WEB_SEARCH_SERVICE_URL=http://localhost:8082
VALIDATOR_SERVICE_URL=http://localhost:8083

# Optional: share filesystem with document service (for dev)
# MODEL_SERVICE_FILE_STORAGE_ROOT=./data/files

# -------------------------------------------------------------------------------
# Document Management Service
# -------------------------------------------------------------------------------
DOCUMENT_SERVICE_APP_NAME=document-management-service
DOCUMENT_SERVICE_ENV=development
DOCUMENT_SERVICE_LOG_LEVEL=INFO
DOCUMENT_SERVICE_HTTP_HOST=127.0.0.1
DOCUMENT_SERVICE_HTTP_PORT=8080

# Storage root for document binaries
DOCUMENT_SERVICE_FILE_STORAGE_ROOT=./data/files

# OCR toggle (set to true when OCR adapter is configured)
DOCUMENT_SERVICE_OCR_ENABLED=false

# Semantic search config
DOCUMENT_SERVICE_SEMANTIC_EMBED_DIM=256
DOCUMENT_SERVICE_SEMANTIC_CHUNK_SIZE=900
DOCUMENT_SERVICE_SEMANTIC_CHUNK_OVERLAP=120
DOCUMENT_SERVICE_QDRANT_COLLECTION=document_chunks

# -------------------------------------------------------------------------------
# MCP transport: how the MCP server accepts connections
#   stdio = local process pipes (default; for direct agent/CLI usage)
#   http  = HTTP JSON-RPC (POST /mcp); required for Docker / network agents
# -------------------------------------------------------------------------------
DOCUMENT_SERVICE_MCP_TRANSPORT=stdio
DOCUMENT_SERVICE_MCP_HTTP_HOST=0.0.0.0
DOCUMENT_SERVICE_MCP_HTTP_PORT=8085

# -------------------------------------------------------------------------------
# PostgreSQL — REQUIRED. The document service crashes on startup if this
# is unset or unreachable. Run the docker compose stack (see docker-compose.yml)
# and use the default DSN below.
# -------------------------------------------------------------------------------
DOCUMENT_SERVICE_POSTGRES_DSN=postgresql://chitragupta:chitragupta_dev@localhost:5432/chitragupta

# -------------------------------------------------------------------------------
# Qdrant — REQUIRED. The document service crashes on startup if this is
# unset or unreachable. Run the docker compose stack and use the default URL.
# -------------------------------------------------------------------------------
DOCUMENT_SERVICE_QDRANT_URL=http://localhost:6333

# -------------------------------------------------------------------------------
# Groq (free-tier fallback for HF when credits are exhausted)
# -------------------------------------------------------------------------------
# Get a key at: https://console.groq.com/keys
# Free tier: 30 RPM, 8K TPM, 1K RPD on qwen/qwen3.6-27b and similar.
# Set ORCHESTRATOR_FALLBACK_PROVIDER=groq and MODEL_SERVICE_FALLBACK_PROVIDER=groq
# to make Groq the automatic fallback when HF fails. When HF_TOKEN is empty,
# Groq becomes the sole primary for both services.
GROQ_API_KEY=
GROQ_VL_MODEL=qwen/qwen3.6-27b
GROQ_LLM_MODEL=qwen/qwen3.8-27b
# Set to "groq" to enable Groq as the automatic fallback when the primary
# provider (HF or Gemini) fails. When the primary provider is unconfigured
# (no HF_TOKEN AND no GEMINI_API_KEY), Groq is used as the sole provider.
MODEL_SERVICE_FALLBACK_PROVIDER=
ORCHESTRATOR_FALLBACK_PROVIDER=

# -------------------------------------------------------------------------------
# Other paid providers (uncomment to enable alternatives to the free tier)
# -------------------------------------------------------------------------------
# FIREWORKS_API_KEY=
# DEEPINFRA_API_KEY=
# OPENAI_API_KEY=

# Web Search Service
WEB_SEARCH_SERVICE_HTTP_HOST=127.0.0.1
WEB_SEARCH_SERVICE_HTTP_PORT=8082
WEB_SEARCH_SERVICE_LOG_LEVEL=INFO

# Firecrawl (search + scrape + crawl)
# Get key at: https://www.firecrawl.dev/app/api-keys
# Free tier: scrape + search work without key (rate-limited)
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1

# Fetch (lightweight URL retrieval, no API key needed)
FETCH_TIMEOUT_MS=15000

# Validator Service
VALIDATOR_SERVICE_HTTP_PORT=8083
MODEL_SERVICE_URL=http://localhost:8081
DOCUMENT_SERVICE_URL=http://localhost:8080
ALERT_RISK_THRESHOLD=0.5
ENCRYPTION_MASTER_KEY=CHANGE_ME_TO_A_RANDOM_STRING

# -------------------------------------------------------------------------------
# Multi-user V1 (local-primary, global-hub in Docker)
# -------------------------------------------------------------------------------
# HS256 secret for email+password JWTs (7-day TTL, sliding refresh).
CHITRAGUPTA_JWT_SECRET=CHANGE_ME_TO_A_RANDOM_STRING
# File-based user store (V1). V2 moves onto the shared Postgres users table.
CHITRAGUPTA_AUTH_DIR=./data/users
# Global hub namespace (Docker volume for now; Postgres+Qdrant in production).
CHITRAGUPTA_GLOBAL_ROOT=./data/global-blobs
# V2-3 shared-infra mirror (same Docker host for now). Unset = filesystem hub only.
GLOBAL_POSTGRES_DSN=
GLOBAL_QDRANT_URL=
GLOBAL_QDRANT_COLLECTION=global_document_chunks
